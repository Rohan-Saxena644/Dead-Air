# Works immediately with no inference credentials.
AI_PROVIDER=scripted
OPENROUTER_API_KEY=
# Verified in the official OpenRouter catalog; price/availability may change.
OPENROUTER_MODEL=google/gemma-3-27b-it
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Verified official Ollama tag. Download separately: ollama pull gemma3:4b
OLLAMA_MODEL=gemma3:4b
DATABASE_PATH=./data/dead-air.sqlite
APP_BASE_URL=http://localhost:3000
# Enable only for a developer/demo environment. Session-scoped metadata, no prompts.
DEV_DEMO_DEBUG=false
